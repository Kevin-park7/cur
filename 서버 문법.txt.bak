# 1. node_modules 삭제
Remove-Item -Recurse -Force node_modules

# 2. package-lock.json 삭제
Remove-Item package-lock.json

# 3. npm 캐시 정리
npm cache clean --force

# 4. 의존성 다시 설치
npm install

# 5. 개발 서버 실행
npm run dev